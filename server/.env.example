# MattStash API server - example settings. Copy to `.env` (git-ignored) and edit; NEVER commit real
# values.
#
# `docker compose` reads a file called `.env` next to the compose file ONLY to fill ${VARIABLES} in
# docker-compose*.yml. It is not passed into the container. The first block below lists the
# variables the shipped compose files interpolate; the second block is a reference of the server's
# own settings (put those in the compose `environment:` section, a Kubernetes ConfigMap, or use
# `docker run --env-file`).

# ---------------------------------------------------------------------------------------------
# Compose interpolation (docker-compose.yml / docker-compose.prod.yml)
# ---------------------------------------------------------------------------------------------
# The uid/gid the container runs as. Must be able to read data/ and secrets/ (and, in write mode,
# write data/). ./start.sh sets these to your own uid/gid automatically.
#MATTSTASH_UID=1000
#MATTSTASH_GID=1000
#MATTSTASH_LOG_LEVEL=info

# ---------------------------------------------------------------------------------------------
# Server settings (reference)
# ---------------------------------------------------------------------------------------------
# KeePass database. The server opens it at startup and never creates one (`mattstash setup` does).
MATTSTASH_DB_PATH=/data/mattstash.kdbx

# Master password: prefer a FILE in a mount that is separate from the data volume.
# (Precedence in the library: KDBX_PASSWORD, then KDBX_PASSWORD_FILE, then a legacy
# .mattstash.txt sidecar next to the database - do not use the sidecar for services.)
KDBX_PASSWORD_FILE=/secrets/kdbx_password.txt
#KDBX_PASSWORD=...    # discouraged: environment variables show up in `docker inspect`

# Who may use the server: a POLICY FILE with principals, tokens (only their hashes) and grants. REQUIRED: the
# server refuses to start without it, and while MATTSTASH_API_KEY, MATTSTASH_API_KEYS_FILE or
# MATTSTASH_REQUIRE_SCOPED_KEYS is set (removed in 0.3; see docs/upgrading-to-0.3.md).
# Create it on the machine you administer from, then mount its DIRECTORY (not the single file: a file
# that is replaced would keep showing the old content inside the container):
#   mattstash admin --policy-file policy/policy.json principal add admin --kind human-device --admin
#   mattstash admin --policy-file policy/policy.json token issue admin --output-file tokens/admin.token
# Add one principal per client with `principal add`, `grant add` and `token issue`.
MATTSTASH_POLICY_FILE=/policy/policy.json

# Read-only unless this is exactly "true". Write mode: single instance + writable data directory
# only (see docker-compose.writable.yml and k8s/writable/).
MATTSTASH_ALLOW_WRITES=false

# Listener (the image's default command is `python -m app`)
MATTSTASH_HOST=0.0.0.0
MATTSTASH_PORT=8000
MATTSTASH_LOG_LEVEL=info

# Optional in-app TLS (a TLS-terminating proxy/ingress is the recommended way; if you enable
# this, switch health probes to https):
#MATTSTASH_TLS_CERT_FILE=/secrets/tls.crt
#MATTSTASH_TLS_KEY_FILE=/secrets/tls.key

# Number of trusted reverse-proxy hops in front of the server (client IP is taken from
# X-Forwarded-For only that many hops back). 0 = no proxy: use the TCP peer address.
#MATTSTASH_TRUSTED_PROXY_HOPS=0

# Rate limiting and other limits (see docs/configuration.md)
MATTSTASH_RATE_LIMIT=100/minute
